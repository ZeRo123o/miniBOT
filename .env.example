MINIBOT_DATABASE_URL=postgresql+asyncpg://minibot:minibot@localhost:5432/minibot

MINIBOT_DEFAULT_MODEL_PROVIDER=mock
MINIBOT_DEFAULT_MODEL_NAME=mock
MINIBOT_CHAT_MODEL_PROVIDER=openai
MINIBOT_CHAT_MODEL_NAME=qwen-plus
MINIBOT_DEEP_RESEARCH_MODEL_PROVIDER=openai
MINIBOT_DEEP_RESEARCH_MODEL_NAME=qwen-plus
MINIBOT_OPENAI_API_KEY=your_model_api_key
MINIBOT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINIBOT_OPENAI_TEMPERATURE=0.2

MINIBOT_TAVILY_API_KEY=your_tavily_api_key
MINIBOT_TAVILY_BASE_URL=https://api.tavily.com
MINIBOT_TAVILY_MAX_RESULTS=5
MINIBOT_TAVILY_SEARCH_DEPTH=basic
MINIBOT_RUNTIME_TOOL_CALL_LIMIT=3
MINIBOT_RUNTIME_TIMEZONE=Asia/Shanghai
MINIBOT_SUMMARY_CONTEXT_WINDOW_TOKENS=128000
MINIBOT_SUMMARY_TRIGGER_RATIO=0.7
MINIBOT_SUMMARY_TRIGGER_TOKENS=90000
MINIBOT_SUMMARY_KEEP_MESSAGES=8
MINIBOT_SUMMARY_MAX_CHARS=3000
