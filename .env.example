MINIBOT_DATABASE_URL=postgresql+asyncpg://minibot:minibot@localhost:5432/minibot
MINIBOT_REDIS_URL=redis://localhost:6379/0
MINIBOT_REDIS_SOCKET_TIMEOUT_SECONDS=2
MINIBOT_MODEL_CACHE_REDIS_KEY=minibot:model_cache
MINIBOT_MODEL_CACHE_LOCAL_TTL_SECONDS=5
MINIBOT_CHAT_RUN_EVENT_TTL_SECONDS=3600
MINIBOT_CHAT_RUN_EVENT_MAX_ENTRIES=20000
MINIBOT_CHAT_RUN_SSE_BLOCK_MS=10000
MINIBOT_CHAT_RUN_MAX_CONCURRENCY=4

MINIBOT_STORAGE_PROVIDER=minio
MINIBOT_STORAGE_BUCKET=minibot
MINIBOT_MINIO_ENDPOINT=localhost:9000
MINIBOT_MINIO_ACCESS_KEY=minibot
MINIBOT_MINIO_SECRET_KEY=minibot123
MINIBOT_MINIO_SECURE=false

MINIBOT_VECTOR_STORE_PROVIDER=milvus
MINIBOT_MILVUS_URI=http://localhost:19530
MINIBOT_MILVUS_DB=minibot
MINIBOT_MILVUS_COLLECTION_PREFIX=kb_
MINIBOT_MILVUS_QUERY_OFFLOAD_LIMIT=8
MINIBOT_EMBEDDING_PROVIDER=openai
MINIBOT_EMBEDDING_MODEL_NAME=text-embedding-v3
MINIBOT_EMBEDDING_DIMENSION=1024
MINIBOT_RERANK_ENABLED=false
MINIBOT_RERANK_PROVIDER=openai
MINIBOT_RERANK_MODEL_NAME=
MINIBOT_RERANK_API_KEY=
MINIBOT_RERANK_BASE_URL=
MINIBOT_RERANK_TIMEOUT_SECONDS=30
MINIBOT_RERANK_BATCH_SIZE=32
MINIBOT_RERANK_MAX_LENGTH=512
MINIBOT_RERANK_NORMALIZE_SCORES=true

MINIBOT_NEO4J_URI=bolt://localhost:7687
MINIBOT_NEO4J_USERNAME=neo4j
MINIBOT_NEO4J_PASSWORD=minibot123
MINIBOT_GRAPH_EXTRACTION_CONCURRENCY=3
MINIBOT_GRAPH_EXTRACTION_CHUNK_CHARS=12000

# Model runtime is managed from the model configuration page:
# model config page -> PostgreSQL -> Redis cache.
# Provider API keys can still be stored in env and referenced by api_key_env.
DASHSCOPE_API_KEY=your_model_api_key
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XIAOMI_MIMO_API_KEY=
XIAOMI_MIMO_TOKEN_PLAN_API_KEY=
MINIMAX_API_KEY=
MODELSCOPE_ACCESS_TOKEN=
MINIBOT_OPENAI_TEMPERATURE=0.2

MINIBOT_TAVILY_API_KEY=your_tavily_api_key
MINIBOT_TAVILY_BASE_URL=https://api.tavily.com
MINIBOT_TAVILY_MAX_RESULTS=5
MINIBOT_TAVILY_SEARCH_DEPTH=basic
MINIBOT_RUNTIME_TOOL_CALL_LIMIT=3
MINIBOT_RUNTIME_TIMEZONE=Asia/Shanghai
MINIBOT_CHAT_UPLOAD_MAX_BYTES=20971520
MINIBOT_CHAT_ATTACHMENT_MARKDOWN_MAX_CHARS=32000

# MinerU document parser (POST /file_parse service)
MINIBOT_MINERU_ENABLED=false
MINIBOT_MINERU_AUTO_SELECT=false
MINIBOT_MINERU_API_URL=http://localhost:30001
MINIBOT_MINERU_TIMEOUT_SECONDS=1800
MINIBOT_MINERU_HEALTH_TIMEOUT_SECONDS=5
MINIBOT_MINERU_MAX_RESPONSE_BYTES=104857600
MINIBOT_MINERU_MAX_ARCHIVE_FILES=1000
MINIBOT_MINERU_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
MINIBOT_SUMMARY_TRIGGER_TOKENS=90000
MINIBOT_SUMMARY_TRIGGER_MESSAGES=0
MINIBOT_SUMMARY_KEEP_MESSAGES=20
MINIBOT_SUMMARY_TRIM_TOKENS_TO_SUMMARIZE=4000
MINIBOT_SUMMARY_OFFLOAD_THRESHOLD_TOKENS=1000
MINIBOT_SUMMARY_OFFLOAD_PREVIEW_LINES=10
MINIBOT_SUMMARY_MAX_RETENTION_RATIO=0.6
